# Semua variabel opsional; nilai di bawah adalah default untuk local dev (bukan secret).
# Wajib diganti jika DJANGO_DEBUG=0 (app menolak start dengan kunci default ini).
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=tata
POSTGRES_USER=tata
POSTGRES_PASSWORD=tata
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATA_DIR=/path/ke/folder/data   (default: <repo>/data)
